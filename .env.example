# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="LearnHub LMS"

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Mux (Video) ──────────────────────────────────────────────────────────────
MUX_TOKEN_ID=<mux-token-id>
MUX_TOKEN_SECRET=<mux-token-secret>
NEXT_PUBLIC_MUX_ENV_KEY=<mux-env-key>
MUX_WEBHOOK_SECRET=<mux-webhook-signing-secret>

# ── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=<resend-api-key>

# ── Certificate ─────────────────────────────────────────────────────────
NEXT_PUBLIC_VERIFY_BASE_URL=http://localhost:3000/verify

# ── Judge0 (optional) ──────────────────────────────────────────────────────
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=<rapidapi-key>

# ── Feature Flags ─────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_CODE_GRADING=false
NEXT_PUBLIC_ENABLE_PROCTORING=false
